<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#E6111111">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="DREXIAN  /  STUDENT" android:textColor="#BFFFFFFF" android:textSize="10sp" android:letterSpacing="0.12" android:textStyle="bold" />
        <TextView android:id="@+id/widget_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#FFFFFFFF" android:textSize="21sp" android:fontFamily="sans" />
    </LinearLayout>
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MONDAY, 2 NOVEMBER" android:textColor="#99FFFFFF" android:textSize="9sp" android:paddingTop="2dp" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#33FFFFFF" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NEXT CLASS" android:textColor="#99FFFFFF" android:textSize="9sp" android:letterSpacing="0.15" />
    <TextView android:id="@+id/widget_next_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Loading timetable…" android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" android:paddingTop="3dp" />
    <TextView android:id="@+id/widget_next_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#CCFFFFFF" android:textSize="10sp" android:paddingTop="3dp" />
    <TextView android:id="@+id/widget_agenda" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="" android:textColor="#99FFFFFF" android:textSize="10sp" android:paddingTop="10dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TAP TO OPEN DASHBOARD  ↗" android:textColor="#77FFFFFF" android:textSize="8sp" android:gravity="end" />
</LinearLayout>
